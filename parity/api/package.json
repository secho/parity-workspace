{
  "name": "parity-api",
  "private": true,
  "type": "module",
  "description": "Parity's backend. Ingests the estate over a read-only MS SQL connection and serves it from its own Postgres.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "reset": "tsx src/cli/reset.ts",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "mssql": "^11.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
