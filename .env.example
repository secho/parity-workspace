# Copy to .env and fill in. NOT a Max/Pro OAuth token — see docs/SPEC.md §4.
ANTHROPIC_API_KEY=sk-ant-

# --- OR route through Claude Platform on AWS ---------------------------------------
# Anthropic-operated with same-day API parity, AWS IAM and AWS Marketplace billing.
# NOT Amazon Bedrock (partner-operated, prefixed model IDs, feature subset). The Agent
# SDK supports it natively and the model IDs are unchanged, so nothing else moves.
# Set all four; leave CLAUDE_CODE_USE_ANTHROPIC_AWS empty to use ANTHROPIC_API_KEY above.
CLAUDE_CODE_USE_ANTHROPIC_AWS=
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=wrkspc_
AWS_REGION=eu-central-1

# live | replay
PARITY_MODE=live
# Divides the recorded gaps when PARITY_MODE=replay. 1 is the honest default — the replay takes
# exactly as long as the run did. Anything above it is a compression, and the demo script says
# which stretches are compressed out loud.
PARITY_REPLAY_SPEED=1

MSSQL_SA_PASSWORD=ParityShop_Dev_2026!
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=ParityShop

# ParityShop services
SHOP_API_PORT=3100
SHOP_WEB_PORT=5180

# Database Mail target for sp_SyncWarehouseDispatch. UI at http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Parity reaches ParityShop as a db_datareader principal, never as sa. Created by
# parity-platform-demo-app/db/40-parity-reader.sql on every `make seed`.
PARITY_READER_USER=parity_reader
PARITY_READER_PASSWORD=Parity_Reader_2026!

# The one principal allowed to EXECUTE, used only by M4's oracle harness and always inside a
# transaction that is rolled back. Separate from the reader above so that "the analysis cannot
# write to the estate" stays true of the credential, not just of the code. No DDL, and DENYed
# sp_SyncWarehouseDispatch because a sent email cannot be rolled back.
# Created by parity-platform-demo-app/db/41-parity-runner.sql on every `make seed`.
PARITY_RUNNER_USER=parity_runner
PARITY_RUNNER_PASSWORD=Parity_Runner_2026!

# The shadow harness replays against a restored copy of ParityShop, never against the estate,
# which is what makes "production is untouched" an observation about the connection string
# rather than an argument about transaction discipline. Built by `make shadow-db` — after
# `make traffic`, because the replay cases name orders that traffic placed.
#
# parity_shadow OWNS that copy and is the only principal allowed to restore it. It has no user
# in ParityShop at all: the one login that can wipe and rebuild a database is the one login
# with no route to production. Created by parity-platform-demo-app/db/50-parity-shadow-login.sql.
MSSQL_SHADOW_DATABASE=ParityShop_Shadow
PARITY_SHADOW_USER=parity_shadow
PARITY_SHADOW_PASSWORD=Parity_Shadow_2026!
MSSQL_SHADOW_BASE_BACKUP=/var/opt/mssql/backup/ParityShop_Shadow_base.bak

# The migration target as a service, in three instances.
#
# `pricing-service` is M5's hand-written REFERENCE implementation. It stays. It is the only
# implementation that diverges from the procedure, which makes it the positive control: the
# proof that the diff engine can still find a real behavioural difference. Prices against the
# shadow copy.
#
# `pricing-service-generated` runs what `implement-service` wrote, also against the shadow
# copy. This is the one that has to go green.
#
# `pricing-service-live` runs the same generated source against the ESTATE, and is what the
# monolith's feature flag routes to. It connects with the shop's own credential, never with
# parity_runner — "Parity cannot write to the estate" must not acquire a footnote.
PRICING_SERVICE_PORT=3300
PRICING_SERVICE_GENERATED_PORT=3301
PRICING_SERVICE_LIVE_PORT=3302

# Parity's own state. 5433 on the host, not 5432 — the presenter's machine already has a
# Postgres, and a demo must not depend on who won the port race.
PARITY_PG_PORT=5433
PARITY_PG_URL=postgres://parity:parity@localhost:5433/parity
PARITY_API_PORT=3200
PARITY_WEB_PORT=5190

# Where `open_pr` opens. ONE repository: docs/DECISIONS.md rules out a remote per app, so the
# PR lands here at the `parity-platform-demo-app/` path. `GITHUB_DEMO_REPO` used to sit here
# and named a repository that does not exist — it was never read by any code.
#
# Do not paste a token. `make github-token` takes it from the `gh` CLI you are already signed
# in to and writes it into .env, which is gitignored. Without one, Parity assembles the PR and
# reports that it cannot open it; it never shows a URL nothing opened.
GITHUB_TOKEN=
GITHUB_OWNER=secho
GITHUB_REPO=parity-workspace
GITHUB_BASE_BRANCH=main
